#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
     keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  0       │  1       │  2       │  3       │  4       │  5       │   │  Y       │  U       │  I       │  O       │  P       │
            &kp N0      &kp N1     &kp N2     &kp N3     &kp N4     &kp N5          &kp Y      &kp U      &kp I      &kp O      &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────├──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  TAB     │  Q       │  W       │  E       │  R       │  T       │   │  H       │  J       │  K       │  L       │ ' "      │
            &kp TAB      &kp Q      &kp W      &kp E      &kp R      &kp T         &kp H      &kp J       &kp K      &kp   L   &kp  SQT
        //├──────────├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  LSHFT   │  A       │  S       │  D       │  F       │  G       │   │  N       │  M       │ , <      │ . >      │ / ?      │
            &kp LSHFT   &kp A      &kp S       &kp D      &kp F     &kp G        &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH 
        //├──────────├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
        //│  LCTRL   │  Z       │  X       │  C       │  V       │  B       │   │ SPACE    │Backspace │ Backspace│
            &kp LCTRL &kp Z      &kp X      &kp C      &kp V      &kp B          &kp SPACE  &kp BSPC    &kp BSPC
        //╰──────────┴──────────┴──────────┴──────────┼──────────┼──────────┤   ╰──────────┴──────────┴──────────╯
                                             &kp ESC   &kp TAB     &kp ENTER 
        //                                 ╰──────────┴──────────┴──────────╯   
            >;
        };
     };
 };