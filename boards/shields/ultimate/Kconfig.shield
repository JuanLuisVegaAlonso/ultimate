# No whitespace after the comma or in your part name!
config SHIELD_ULTIMATE_LEFT
    def_bool $(shields_list_contains,ultimate_left)

# No whitespace after the comma or in your part name!
config SHIELD_ULTIMATE_RIGHT
    def_bool $(shields_list_contains,ultimate_right)


# Enable Analog Input
#CONFIG_ADC=y
# Use async mode (Optional)
#CONFIG_ADC_ASYNC=y

# Enable Analog Input Module
#CONFIG_ANALOG_INPUT=y
# CONFIG_ANALOG_INPUT_LOG_LEVEL_DBG=y
# CONFIG_ANALOG_INPUT_REPORT_INTERVAL_MIN=22

# Enable logging for pre/post processed value
#CONFIG_ANALOG_INPUT_LOG_DBG_RAW=y
#CONFIG_ANALOG_INPUT_LOG_DBG_REPORT=y

# Just in case, you don't RTFM
#CONFIG_INPUT=y

# ↓↓↓↓ Advence Settings ↓↓↓↓

# Enable using explicit ADC channels config from device tree
# - default to false
# - It allows composited channel to be used. e.g. differential with +/-vRef.
#CONFIG_ANALOG_INPUT_USE_DTS_ADC_CH_CFG=n

# ADC channels resolution (in bit)
# - default to 12 bit
# - With above CONFIG_ANALOG_INPUT_USE_DTS_ADC_CH_CFG=y, it might need this 
#   to enlarge buffer of ADC sequencer for 24bit hi-res ADC.
#ANALOG_INPUT_ADC_RES=12

# Enable ZMK mouse emulations
#CONFIG_ZMK_POINTING=y

## OLED display
CONFIG_ZMK_DISPLAY=y
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y

# "Eager Debouncing"
# Trying to lower the input lag.
CONFIG_ZMK_KSCAN_DEBOUNCE_PRESS_MS=1
CONFIG_ZMK_KSCAN_DEBOUNCE_RELEASE_MS=1
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
CONFIG_ZMK_BLE_EXPERIMENTAL_FEATURES=y


# Config for the widgets

CONFIG_NICE_OLED_WIDGET_ANIMATION_PERIPHERAL_SMART_BATTERY=n
CONFIG_NICE_OLED_WIDGET_ANIMATION_PERIPHERAL_CAT=n
CONFIG_NICE_OLED_WIDGET_ANIMATION_PERIPHERAL_POKEMON=y
CONFIG_NICE_OLED_WIDGET_WPM_BONGO_CAT=n
CONFIG_NICE_OLED_WIDGET_WPM_GRAPH_FIXED_RANGE=y
CONFIG_NICE_OLED_WIDGET_WPM_GRAPH=y
CONFIG_NICE_OLED_WIDGET_WPM_LUNA=n
CONFIG_NICE_OLED_WIDGET_HID_INDICATORS=n
CONFIG_ZMK_HID_INDICATORS=n
CONFIG_NICE_OLED_WIDGET_WPM_GRAPH_FIXED_RANGE_MAX=90
CONFIG_NICE_OLED_WIDGET_MODIFIERS_INDICATORS_FIXED_SYMBOL_WINDOWS=y
CONFIG_NICE_OLED_WIDGET_MODIFIERS_INDICATORS_FIXED_SYMBOL_MACOS=n
CONFIG_NICE_OLED_WIDGET_WPM_NUMBER=y

# Triying to solve the soft-off issue
CONFIG_NFCT_PINS_AS_GPIOS=y

CONFIG_ZMK_PM_SOFT_OFF=y